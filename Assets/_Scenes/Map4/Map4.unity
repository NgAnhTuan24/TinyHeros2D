--- !u!114 &1067675049
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1067675047}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac27dd1c1afbf2c4f9cab0ed1601e084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueID: MeetTheBoss_Map4
  lines:
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "At last\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "you\u2019ve made it here."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: You.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Be careful!
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: The Land of Forgetting.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: A place where everything slowly disappears with time.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: You know this place?
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: Better than anyone.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Because I have remained here\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: for a very long time.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Then what is all of this supposed to mean?
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "You still haven\u2019t realized?"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Since the beginning of your journey\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "you\u2019ve been searching for something."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: An answer.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Then tell me!
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: No.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: The answer does not lie in words.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: It lies within your choice.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "I don\u2019t care what it is anymore."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: I just want to end all of this.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Hah\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "So\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "you\u2019ve finally spoken honestly."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "But if you wish to end this\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "First\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: you must defeat me.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Get ready!
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "He\u2019s coming!"
  afterBattleLines:
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Hah\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "It\u2019s over\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: No.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: This is where everything begins.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: What do you mean?
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "You still don\u2019t understand?"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: I was never your enemy.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "I was merely\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: the one standing at the end of this journey.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "From the very beginning\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "what you were searching for\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: was never power.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: nor answers.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "It was the reason\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: to keep moving forward.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "And what if I still haven\u2019t found it?"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Hah\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: then keep searching.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: No one can give you that answer except yourself.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "The road ahead\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: 'now belongs to you. '
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Then\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "I\u2019ll walk it myself."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Good\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Don\u2019t lose yourself\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: within this Land of Forgetting.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "He\u2019s gone\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: No.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Maybe\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: he was never truly meant to be defeated.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "So\u2026 what do we do now? "
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: We keep moving.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: This is no longer a journey for answers.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "It\u2019s a journey\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: chosen by me.
  spawnAfterDialogue: 1
  enemyPrefab: {fileID: 4599673091857622171, guid: 54a90a0b120f0a94baa321dd19bffe8a, type: 3}
  spawnPoint: {fileID: 800399668}
  portalPrefab: {fileID: 3837343559919417281, guid: 80da63501610efb4b8cd26e12106035f, type: 3}
  portalSpawnPoint: {fileID: 1160256135}
  allowReplayEnemy: 1
