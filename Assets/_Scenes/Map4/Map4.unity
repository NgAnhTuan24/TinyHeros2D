--- !u!114 &2137381597
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2137381594}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac27dd1c1afbf2c4f9cab0ed1601e084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueID: Intro_Map4
  lines:
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Where is this\u2026?"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: The Land of Forgetting.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Forgetting\u2026?"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Legends say\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "anyone who steps into this place\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: will eventually lose
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: what matters most to them.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "The snow\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "and that mountain\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Everything here is too quiet.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Like time itself has stopped.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "No\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: it feels more like this place is waiting for someone.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Maybe\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "it\u2019s waiting for us."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "After everything\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: we finally made it here.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Be careful.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: I have a bad feeling about this.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Yeah\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Whatever lies ahead\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: we keep moving forward.
  afterBattleLines: []
  spawnAfterDialogue: 0
  enemyPrefab: {fileID: 0}
  spawnPoint: {fileID: 0}
  portalPrefab: {fileID: 0}
  portalSpawnPoint: {fileID: 0}
  allowReplayEnemy: 1
