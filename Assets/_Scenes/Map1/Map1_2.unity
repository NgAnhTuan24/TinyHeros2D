--- !u!114 &1029485281
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1029485278}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac27dd1c1afbf2c4f9cab0ed1601e084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueID: Intro_Enemy_2
  lines:
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Another one\u2026 but it looks different."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Yeah\u2026 it doesn\u2019t look like the Bub from before."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: This is a Pokey Bub.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Its behavior is similar, but don\u2019t let the appearance fool you."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "So\u2026 same weakness?"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Yes. Aim for the head.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Jump at the right moment.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Got it. I\u2019ll handle it."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Stay sharp.
  afterBattleLines:
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Heh, that was nothing.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Awesome, keep it going!
  spawnAfterDialogue: 1
  enemyPrefab: {fileID: 5578154834244353745, guid: 78d3bd036edf6844aa04ec6f7c13528f, type: 3}
  spawnPoint: {fileID: 1334320567}
  portalPrefab: {fileID: 0}
  portalSpawnPoint: {fileID: 0}
