--- !u!114 &1896549011
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1896549010}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac27dd1c1afbf2c4f9cab0ed1601e084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueID: Intro_Enemy_3
  lines:
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Wait\u2026 this one is different."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "It\u2019s not reacting like the others."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "That\u2019s an Orange."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "It can detect you from a distance\u2026 and it will chase you."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: So I just jump on it like before?
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "No. That won\u2019t work this time."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Its head is not a weak point.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Then how do I defeat it?
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: You need to attack it directly.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Watch its movement\u2026 and strike at the right moment."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Understood. I\u2019ll be careful."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Stay alert. It won\u2019t go down easily."
  afterBattleLines: []
  spawnAfterDialogue: 0
  enemyPrefab: {fileID: 0}
  spawnPoint: {fileID: 0}
  portalPrefab: {fileID: 0}
  portalSpawnPoint: {fileID: 0}
