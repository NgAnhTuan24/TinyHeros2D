--- !u!114 &5006492
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5006490}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac27dd1c1afbf2c4f9cab0ed1601e084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueID: Intro_Enemy_1
  lines:
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Wait\u2026 something\u2019s ahead."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Huh... What is that creature?
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "That\u2019s a Bub."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "It may look cute, but don\u2019t get too close carelessly."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: So how do I defeat it?
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Its weakness is on the head.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Try jumping on top of it.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Timing is important.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Got it!
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Defeat it, and move forward.
  afterBattleLines: []
  spawnAfterDialogue: 0
  enemyPrefab: {fileID: 0}
  spawnPoint: {fileID: 0}
  portalPrefab: {fileID: 0}
  portalSpawnPoint: {fileID: 0}
