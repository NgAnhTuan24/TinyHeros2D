MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2014537767}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac27dd1c1afbf2c4f9cab0ed1601e084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueID: Intro_SafeZone
  lines:
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Looks like you made it to a safe place.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Yeah\u2026 it feels calmer here."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: This is a place where you can rest.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: If you fall in battle, you will return here.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: So this is like a checkpoint?
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Exactly.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Take a moment to recover before moving on.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Got it. This will help a lot.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Stay strong. Your journey is far from over.
  afterBattleLines: []
  spawnAfterDialogue: 0
  enemyPrefab: {fileID: 0}
  spawnPoint: {fileID: 0}
  portalPrefab: {fileID: 0}
  portalSpawnPoint: {fileID: 0}
