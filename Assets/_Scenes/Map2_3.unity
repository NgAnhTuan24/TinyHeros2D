--- !u!114 &207593205
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 207593204}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac27dd1c1afbf2c4f9cab0ed1601e084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueID: EndTurn_Map2
  lines:
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "You keep moving forward\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Have you been watching me this whole time?
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: Maybe.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Or maybe\u2026 I never left this place."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Who are you, really?
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: Wrong question.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "You should be asking\u2026 why you are here."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026What are you talking about?"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: You fight.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: You move forward.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: But do you truly understand why?
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "I don\u2019t need your explanation!"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: Exactly.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Because you\u2019ll find the answer yourself."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: Defeat me.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Maybe then\u2026 you\u2019ll understand a part of it."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: If you survive.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "He\u2019s not going to say more\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Get ready to fight!
  afterBattleLines:
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Heh\u2026 so you\u2019ve done it."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "It\u2019s over\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Be careful! He\u2019s not gone yet!"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Not bad\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "At least you\u2019re no longer as weak as before."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Who are you!? Tell me!
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "You still don\u2019t understand\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: This is only the beginning.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026What?"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "The path you\u2019re walking\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: was never your choice.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: What are you talking about!?
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "You\u2019ll understand soon enough\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: when everything starts to fall apart.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "I\u2019ll see you again\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: where you can no longer turn back.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Wait\u2014!"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "He\u2019s gone\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "I don\u2019t like what he said\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: We have to keep moving.
  spawnAfterDialogue: 1
  enemyPrefab: {fileID: 4599673091857622171, guid: f396ba344a6e07e44acc2e774dc819c7, type: 3}
  spawnPoint: {fileID: 536506909}
  portalPrefab: {fileID: 3837343559919417281, guid: 80da63501610efb4b8cd26e12106035f, type: 3}
  portalSpawnPoint: {fileID: 598610997}
