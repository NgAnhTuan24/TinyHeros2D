--- !u!114 &1248242970
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1248242969}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac27dd1c1afbf2c4f9cab0ed1601e084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueID: EndTurn_Map3
  lines:
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: The fun ends here.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Be careful\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "So\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: have you found your answer yet?
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "I don\u2019t need the answer right now."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Then you still don\u2019t understand."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "You\u2019re just moving forward\u2026 without knowing where you\u2019re
      going."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Maybe.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "But I\u2019m not stopping because of that."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Hahaha\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "What you\u2019re saying\u2026 is laughable."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "You speak of moving forward\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "yet you haven\u2019t even surpassed me."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "\u2026"
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Then I\u2019ll prove it."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: Good.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "That\u2019s what I wanted to hear."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Show me\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: whether your resolve is real.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Or if you\u2019ll break\u2026 like all the others."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Get ready!
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "He\u2019s coming!"
  afterBattleLines:
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Hah\u2026 so you made it."
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: Not bad.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "I\u2019ll see you again\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: next time.
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "Then\u2026"
  - speaker: 0
    icon: {fileID: 21300000, guid: aa77b147d5d5c8b44844a59ddfd5c037, type: 3}
    name: Satyr
    text: "you\u2019ll know what you truly need."
  spawnAfterDialogue: 1
  enemyPrefab: {fileID: 4599673091857622171, guid: 42987dd51a7412c44bca366925d1916e, type: 3}
  spawnPoint: {fileID: 775786666}
  portalPrefab: {fileID: 3837343559919417281, guid: 80da63501610efb4b8cd26e12106035f, type: 3}
  portalSpawnPoint: {fileID: 438968024}
