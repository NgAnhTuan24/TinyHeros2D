--- !u!114 &1078416100
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1078416099}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac27dd1c1afbf2c4f9cab0ed1601e084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueID: NextTurn_Map3
  lines:
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Look, the sea!
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Wow\u2026 it\u2019s beautiful."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: This is Aurel Beach.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "It\u2019s been a while since I\u2019ve seen a place this peaceful."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "After everything we\u2019ve been through\u2026 we really needed a break."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "If we had time, I\u2019d stay here longer."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: Haha, sounds like a vacation.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Maybe it is.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: A short break before continuing our journey.
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Still\u2026 don\u2019t let your guard down."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "I don\u2019t think it\u2019ll stay peaceful forever."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Yeah\u2026 let\u2019s just enjoy it while it lasts."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Come on!
  afterBattleLines: []
  spawnAfterDialogue: 0
