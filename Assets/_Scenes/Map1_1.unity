--- !u!114 &259739238
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 259739236}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac27dd1c1afbf2c4f9cab0ed1601e084, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "Hello, dear player. I\u2019m Flora, and I\u2019ll be your companion throughout
      your journey."
  - speaker: 1
    icon: {fileID: 0}
    name: 
    text: "Hi Flora\u2026 where is this place?"
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: This place is called Micronia.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: A place where your adventure begins, full of things waiting to be discovered.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "There\u2019s a lot waiting for you ahead."
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: "I\u2019ll be here to guide you along the way."
  afterBattleLines:
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Nicely done.
  - speaker: 0
    icon: {fileID: 21300000, guid: 27a0e13141500e349bb75f01c01c53ad, type: 3}
    name: Flora
    text: Keep going.
  spawnAfterDialogue: 1
  enemyPrefab: {fileID: 4037037466226299324, guid: 50f4f6329dd36fd40b28dab4b5577bcd, type: 3}
  spawnPoint: {fileID: 2142995}
  portalPrefab: {fileID: 0}
  portalSpawnPoint: {fileID: 0}
